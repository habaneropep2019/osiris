.SH NAME
QConstString \- A QString which uses constant Unicode data
\fBClasses\fR - Annotated - Tree - Functions - Home - \fBStructure\fR </div>
.br
.SH SYNOPSIS
.br
.PP
\fC#include <qstring.h>\fR
.PP
.SS "Public Members"
.in +1c
.ti -1c
.BI "\fBQConstString\fR ( QChar * " "unicode" ", uint length )"
.br
