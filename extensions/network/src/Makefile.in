#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS) $(SYSCONF_CXXFLAGS_LIB)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS) $(SYSCONF_CFLAGS_LIB)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ../../../lib/
VER_MAJ = 0
VER_MIN = 1
VER_PATCH = 0
TARGET	= qnetwork
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	qserversocket.h \
		qsocket.h \
		qsocketdevice.h
SOURCES =	qserversocket.cpp \
		qsocket.cpp \
		qsocketdevice.cpp
OBJECTS =	qserversocket.o \
		qsocket.o \
		qsocketdevice.o
SRCMOC	=	moc_qserversocket.cpp \
		moc_qsocket.cpp
OBJMOC	=	moc_qserversocket.o \
		moc_qsocket.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(SYSCONF_LINK_TARGET_STATIC)

$(DESTDIR)$(SYSCONF_LINK_TARGET_STATIC): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK_LIB_STATIC)

moc: $(SRCMOC)

tmake:
	tmake qnetwork.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

qserversocket.o: qserversocket.cpp \
		qserversocket.h \
		qsocket.h \
		qsocketdevice.h

qsocket.o: qsocket.cpp \
		qsocket.h \
		qsocketdevice.h

qsocketdevice.o: qsocketdevice.cpp \
		qsocketdevice.h

moc_qserversocket.o: moc_qserversocket.cpp \
		qserversocket.h \
		qsocket.h \
		qsocketdevice.h

moc_qsocket.o: moc_qsocket.cpp \
		qsocket.h \
		qsocketdevice.h

moc_qserversocket.cpp: qserversocket.h
	$(MOC) qserversocket.h -o moc_qserversocket.cpp

moc_qsocket.cpp: qsocket.h
	$(MOC) qsocket.h -o moc_qsocket.cpp

