#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS_OPENGL) $(SYSCONF_CXXFLAGS_X11) $(SYSCONF_CXXFLAGS) $(SYSCONF_CXXFLAGS_LIB)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS) $(SYSCONF_CFLAGS_LIB)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_OPENGL) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_OPENGL) $(SYSCONF_LIBS_X11)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ../../../lib/
VER_MAJ = 4
VER_MIN = 4
VER_PATCH = 0
TARGET	= qgl
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	qgl.h
SOURCES =	qgl.cpp \
		qgl_x11.cpp
OBJECTS =	qgl.o \
		qgl_x11.o
SRCMOC	=	moc_qgl.cpp \
		qgl_x11.moc
OBJMOC	=	moc_qgl.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(SYSCONF_LINK_TARGET_STATIC)

$(DESTDIR)$(SYSCONF_LINK_TARGET_STATIC): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK_LIB_STATIC)

moc: $(SRCMOC)

tmake:
	tmake qgl.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

qgl.o: qgl.cpp \
		qgl.h

qgl_x11.o: qgl_x11.cpp \
		qgl_x11.moc \
		qgl.h

moc_qgl.o: moc_qgl.cpp \
		qgl.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_qgl.o moc_qgl.cpp

moc_qgl.cpp: qgl.h
	$(MOC) qgl.h -o moc_qgl.cpp

qgl_x11.moc: qgl_x11.cpp
	$(MOC) qgl_x11.cpp -o qgl_x11.moc

