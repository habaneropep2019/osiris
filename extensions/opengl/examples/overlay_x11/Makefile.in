#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS_OPENGL) $(SYSCONF_CXXFLAGS_X11) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_OPENGL) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT_OPENGL) $(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_OPENGL) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
VER_PATCH = 0
TARGET	= overlayrubber
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	gearwidget.h \
		rubberbandwidget.h
SOURCES =	gearwidget.cpp \
		main.cpp \
		rubberbandwidget.cpp
OBJECTS =	gearwidget.o \
		main.o \
		rubberbandwidget.o
SRCMOC	=	
OBJMOC	=	

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake overlayrubber.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

gearwidget.o: gearwidget.cpp \
		gearwidget.h

main.o: main.cpp \
		gearwidget.h \
		rubberbandwidget.h

rubberbandwidget.o: rubberbandwidget.cpp \
		rubberbandwidget.h

