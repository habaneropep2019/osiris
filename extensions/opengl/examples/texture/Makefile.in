#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS_OPENGL) $(SYSCONF_CXXFLAGS_X11) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_OPENGL) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT_OPENGL) $(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_OPENGL) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
TARGET	= texture
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	gltexobj.h \
		globjwin.h
SOURCES =	gltexobj.cpp \
		globjwin.cpp \
		main.cpp
OBJECTS =	gltexobj.o \
		globjwin.o \
		main.o
SRCMOC	=	moc_gltexobj.cpp \
		moc_globjwin.cpp
OBJMOC	=	moc_gltexobj.o \
		moc_globjwin.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake texture.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

gltexobj.o: gltexobj.cpp \
		gltexobj.h

globjwin.o: globjwin.cpp \
		globjwin.h \
		gltexobj.h

main.o: main.cpp \
		globjwin.h

moc_gltexobj.o: moc_gltexobj.cpp \
		gltexobj.h

moc_globjwin.o: moc_globjwin.cpp \
		globjwin.h

moc_gltexobj.cpp: gltexobj.h
	$(MOC) gltexobj.h -o moc_gltexobj.cpp

moc_globjwin.cpp: globjwin.h
	$(MOC) globjwin.h -o moc_globjwin.cpp

