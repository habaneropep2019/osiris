#############################################################################
# Makefile for building targets in sub directories.
# Generated by tmake at 14:11, 2000/05/25
#     Project: examples
#    Template: subdirs
#############################################################################

SUBDIRS =	mainlyQt \
		mainlyXt \
		mainlyMotif

all: $(SUBDIRS)

$(SUBDIRS): FORCE
	cd $@; $(MAKE)

clean:
	for i in $(SUBDIRS); do ( cd $$i ; $(MAKE) clean ) ; done

FORCE:
