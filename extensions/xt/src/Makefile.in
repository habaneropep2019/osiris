#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS) $(SYSCONF_CXXFLAGS_LIB)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS) $(SYSCONF_CFLAGS_LIB)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ../../../lib/
VER_MAJ = 0
VER_MIN = 3
VER_PATCH = 0
TARGET	= qxt
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	../../../include/qxt.h
SOURCES =	qxt.cpp
OBJECTS =	qxt.o
SRCMOC	=	../../../include/moc_qxt.cpp
OBJMOC	=	../../../include/moc_qxt.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(SYSCONF_LINK_TARGET_STATIC)

$(DESTDIR)$(SYSCONF_LINK_TARGET_STATIC): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK_LIB_STATIC)

moc: $(SRCMOC)

tmake:
	tmake qxt.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

qxt.o: qxt.cpp \
		qxt.h

../../../include/moc_qxt.o: ../../../include/moc_qxt.cpp \
		../../../include/qxt.h \
		../../../include/qapplication.h \
		../../../include/qwidget.h \
		../../../include/qwindowdefs.h \
		../../../include/qobjectdefs.h \
		../../../include/qglobal.h \
		../../../include/qstring.h \
		../../../include/qcstring.h \
		../../../include/qarray.h \
		../../../include/qgarray.h \
		../../../include/qshared.h \
		../../../include/qnamespace.h \
		../../../include/qobject.h \
		../../../include/qevent.h \
		../../../include/qregion.h \
		../../../include/qrect.h \
		../../../include/qsize.h \
		../../../include/qpoint.h \
		../../../include/qmime.h \
		../../../include/qlist.h \
		../../../include/qglist.h \
		../../../include/qcollection.h \
		../../../include/qstringlist.h \
		../../../include/qvaluelist.h \
		../../../include/qdatastream.h \
		../../../include/qiodevice.h \
		../../../include/qpaintdevice.h \
		../../../include/qpalette.h \
		../../../include/qcolor.h \
		../../../include/qbrush.h \
		../../../include/qcursor.h \
		../../../include/qfont.h \
		../../../include/qfontmetrics.h \
		../../../include/qfontinfo.h \
		../../../include/qstyle.h \
		../../../include/qsizepolicy.h \
		../../../include/qasciidict.h \
		../../../include/qgdict.h \
		../../../include/qtranslator.h \
		../../../include/qintdict.h

../../../include/moc_qxt.cpp: ../../../include/qxt.h
	$(MOC) ../../../include/qxt.h -o ../../../include/moc_qxt.cpp

