#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS) $(SYSCONF_CXXFLAGS_LIB)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS) $(SYSCONF_CFLAGS_LIB)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ../../../lib/
VER_MAJ = 0
VER_MIN = 1
VER_PATCH = 0
TARGET	= qimgio
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	qimageio.h \
		qjpegio.h
SOURCES =	qimageio.cpp \
		qjpegio.cpp
OBJECTS =	qimageio.o \
		qjpegio.o
SRCMOC	=	
OBJMOC	=	

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(SYSCONF_LINK_TARGET)

$(DESTDIR)$(SYSCONF_LINK_TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK_LIB)

moc: $(SRCMOC)

tmake:
	tmake qimageio.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

qimageio.o: qimageio.cpp \
		qjpegio.h

qjpegio.o: qjpegio.cpp

