#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
VER_PATCH = 0
TARGET	= themes
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	themes.h \
		../buttongroups/buttongroups.h \
		../lineedits/lineedits.h \
		../listboxcombo/listboxcombo.h \
		../checklists/checklists.h \
		../progressbar/progressbar.h \
		../rangecontrols/rangecontrols.h \
		../richtext/richtext.h \
		wood.h \
		methal.h
SOURCES =	themes.cpp \
		main.cpp \
		../buttongroups/buttongroups.cpp \
		../lineedits/lineedits.cpp \
		../listboxcombo/listboxcombo.cpp \
		../checklists/checklists.cpp \
		../progressbar/progressbar.cpp \
		../rangecontrols/rangecontrols.cpp \
		../richtext/richtext.cpp \
		wood.cpp \
		metal.cpp
OBJECTS =	themes.o \
		main.o \
		../buttongroups/buttongroups.o \
		../lineedits/lineedits.o \
		../listboxcombo/listboxcombo.o \
		../checklists/checklists.o \
		../progressbar/progressbar.o \
		../rangecontrols/rangecontrols.o \
		../richtext/richtext.o \
		wood.o \
		metal.o
SRCMOC	=	moc_themes.cpp \
		../buttongroups/moc_buttongroups.cpp \
		../lineedits/moc_lineedits.cpp \
		../listboxcombo/moc_listboxcombo.cpp \
		../checklists/moc_checklists.cpp \
		../progressbar/moc_progressbar.cpp \
		../rangecontrols/moc_rangecontrols.cpp \
		../richtext/moc_richtext.cpp
OBJMOC	=	moc_themes.o \
		../buttongroups/moc_buttongroups.o \
		../lineedits/moc_lineedits.o \
		../listboxcombo/moc_listboxcombo.o \
		../checklists/moc_checklists.o \
		../progressbar/moc_progressbar.o \
		../rangecontrols/moc_rangecontrols.o \
		../richtext/moc_richtext.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake themes.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

themes.o: themes.cpp \
		themes.h \
		wood.h \
		metal.h \
		../buttongroups/buttongroups.h \
		../lineedits/lineedits.h \
		../listboxcombo/listboxcombo.h \
		../checklists/checklists.h \
		../progressbar/progressbar.h \
		../rangecontrols/rangecontrols.h \
		../richtext/richtext.h

main.o: main.cpp \
		themes.h \
		metal.h

../buttongroups/buttongroups.o: ../buttongroups/buttongroups.cpp \
		../buttongroups/buttongroups.h

../lineedits/lineedits.o: ../lineedits/lineedits.cpp \
		../lineedits/lineedits.h

../listboxcombo/listboxcombo.o: ../listboxcombo/listboxcombo.cpp \
		../listboxcombo/listboxcombo.h

../checklists/checklists.o: ../checklists/checklists.cpp \
		../checklists/checklists.h

../progressbar/progressbar.o: ../progressbar/progressbar.cpp \
		../progressbar/progressbar.h

../rangecontrols/rangecontrols.o: ../rangecontrols/rangecontrols.cpp \
		../rangecontrols/rangecontrols.h

../richtext/richtext.o: ../richtext/richtext.cpp \
		../richtext/richtext.h

wood.o: wood.cpp \
		wood.h

metal.o: metal.cpp \
		metal.h \
		metal.xpm \
		stonedark.xpm \
		stone1.xpm \
		marble.xpm

moc_themes.o: moc_themes.cpp \
		themes.h

../buttongroups/moc_buttongroups.o: ../buttongroups/moc_buttongroups.cpp \
		../buttongroups/buttongroups.h

../lineedits/moc_lineedits.o: ../lineedits/moc_lineedits.cpp \
		../lineedits/lineedits.h

../listboxcombo/moc_listboxcombo.o: ../listboxcombo/moc_listboxcombo.cpp \
		../listboxcombo/listboxcombo.h

../checklists/moc_checklists.o: ../checklists/moc_checklists.cpp \
		../checklists/checklists.h

../progressbar/moc_progressbar.o: ../progressbar/moc_progressbar.cpp \
		../progressbar/progressbar.h

../rangecontrols/moc_rangecontrols.o: ../rangecontrols/moc_rangecontrols.cpp \
		../rangecontrols/rangecontrols.h

../richtext/moc_richtext.o: ../richtext/moc_richtext.cpp \
		../richtext/richtext.h

moc_themes.cpp: themes.h
	$(MOC) themes.h -o moc_themes.cpp

../buttongroups/moc_buttongroups.cpp: ../buttongroups/buttongroups.h
	$(MOC) ../buttongroups/buttongroups.h -o ../buttongroups/moc_buttongroups.cpp

../lineedits/moc_lineedits.cpp: ../lineedits/lineedits.h
	$(MOC) ../lineedits/lineedits.h -o ../lineedits/moc_lineedits.cpp

../listboxcombo/moc_listboxcombo.cpp: ../listboxcombo/listboxcombo.h
	$(MOC) ../listboxcombo/listboxcombo.h -o ../listboxcombo/moc_listboxcombo.cpp

../checklists/moc_checklists.cpp: ../checklists/checklists.h
	$(MOC) ../checklists/checklists.h -o ../checklists/moc_checklists.cpp

../progressbar/moc_progressbar.cpp: ../progressbar/progressbar.h
	$(MOC) ../progressbar/progressbar.h -o ../progressbar/moc_progressbar.cpp

../rangecontrols/moc_rangecontrols.cpp: ../rangecontrols/rangecontrols.h
	$(MOC) ../rangecontrols/rangecontrols.h -o ../rangecontrols/moc_rangecontrols.cpp

../richtext/moc_richtext.cpp: ../richtext/richtext.h
	$(MOC) ../richtext/richtext.h -o ../richtext/moc_richtext.cpp

