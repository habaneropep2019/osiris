#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
VER_PATCH = 0
TARGET	= themes
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	themes.h \
		../buttons_groups/buttons_groups.h \
		../lineedits/lineedits.h \
		../listbox_combo/listbox_combo.h \
		../checklists/checklists.h \
		../progressbar/progressbar.h \
		../rangecontrols/rangecontrols.h \
		../richtext/richtext.h \
		wood.h \
		methal.h
SOURCES =	themes.cpp \
		main.cpp \
		../buttons_groups/buttons_groups.cpp \
		../lineedits/lineedits.cpp \
		../listbox_combo/listbox_combo.cpp \
		../checklists/checklists.cpp \
		../progressbar/progressbar.cpp \
		../rangecontrols/rangecontrols.cpp \
		../richtext/richtext.cpp \
		wood.cpp \
		metal.cpp
OBJECTS =	themes.o \
		main.o \
		../buttons_groups/buttons_groups.o \
		../lineedits/lineedits.o \
		../listbox_combo/listbox_combo.o \
		../checklists/checklists.o \
		../progressbar/progressbar.o \
		../rangecontrols/rangecontrols.o \
		../richtext/richtext.o \
		wood.o \
		metal.o
SRCMOC	=	moc_themes.cpp \
		../buttons_groups/moc_buttons_groups.cpp \
		../lineedits/moc_lineedits.cpp \
		../listbox_combo/moc_listbox_combo.cpp \
		../checklists/moc_checklists.cpp \
		../progressbar/moc_progressbar.cpp \
		../rangecontrols/moc_rangecontrols.cpp \
		../richtext/moc_richtext.cpp
OBJMOC	=	moc_themes.o \
		../buttons_groups/moc_buttons_groups.o \
		../lineedits/moc_lineedits.o \
		../listbox_combo/moc_listbox_combo.o \
		../checklists/moc_checklists.o \
		../progressbar/moc_progressbar.o \
		../rangecontrols/moc_rangecontrols.o \
		../richtext/moc_richtext.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake themes.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

