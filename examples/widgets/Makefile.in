#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	-I../aclock -I../dclock
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
VER_PATCH = 0
TARGET	= widgets
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	widgets.h \
		../aclock/aclock.h \
		../dclock/dclock.h
SOURCES =	main.cpp \
		widgets.cpp \
		../aclock/aclock.cpp \
		../dclock/dclock.cpp
OBJECTS =	main.o \
		widgets.o \
		../aclock/aclock.o \
		../dclock/dclock.o
SRCMOC	=	moc_widgets.cpp \
		../aclock/moc_aclock.cpp \
		../dclock/moc_dclock.cpp
OBJMOC	=	moc_widgets.o \
		../aclock/moc_aclock.o \
		../dclock/moc_dclock.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake widgets.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

main.o: main.cpp \
		widgets.h

widgets.o: widgets.cpp \
		widgets.h \
		../aclock/aclock.h \
		../dclock/dclock.h \
		../application/fileopen.xpm \
		../application/filesave.xpm \
		../application/fileprint.xpm

../aclock/aclock.o: ../aclock/aclock.cpp \
		../aclock/aclock.h

../dclock/dclock.o: ../dclock/dclock.cpp \
		../dclock/dclock.h

moc_widgets.o: moc_widgets.cpp \
		widgets.h

../aclock/moc_aclock.o: ../aclock/moc_aclock.cpp \
		../aclock/aclock.h

../dclock/moc_dclock.o: ../dclock/moc_dclock.cpp \
		../dclock/dclock.h

moc_widgets.cpp: widgets.h
	$(MOC) widgets.h -o moc_widgets.cpp

../aclock/moc_aclock.cpp: ../aclock/aclock.h
	$(MOC) ../aclock/aclock.h -o ../aclock/moc_aclock.cpp

../dclock/moc_dclock.cpp: ../dclock/dclock.h
	$(MOC) ../dclock/dclock.h -o ../dclock/moc_dclock.cpp

