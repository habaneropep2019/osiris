		../../include/qarray.h \
		../../include/qgarray.h \
		../../include/qshared.h \
		../../include/qnamespace.h \
		../../include/qobject.h \
		../../include/qevent.h \
		../../include/qregion.h \
		../../include/qrect.h \
		../../include/qsize.h \
