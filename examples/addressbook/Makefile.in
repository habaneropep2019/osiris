#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
VER_PATCH = 0
TARGET	= addressbook
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	centralwidget.h \
		mainwindow.h
SOURCES =	centralwidget.cpp \
		main.cpp \
		mainwindow.cpp
OBJECTS =	centralwidget.o \
		main.o \
		mainwindow.o
SRCMOC	=	moc_centralwidget.cpp \
		moc_mainwindow.cpp
OBJMOC	=	moc_centralwidget.o \
		moc_mainwindow.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake addressbook.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

centralwidget.o: centralwidget.cpp \
		centralwidget.h

main.o: main.cpp \
		mainwindow.h

mainwindow.o: mainwindow.cpp \
		mainwindow.h \
		centralwidget.h

moc_centralwidget.o: moc_centralwidget.cpp \
		centralwidget.h

moc_mainwindow.o: moc_mainwindow.cpp \
		mainwindow.h

moc_centralwidget.cpp: centralwidget.h
	$(MOC) centralwidget.h -o moc_centralwidget.cpp

moc_mainwindow.cpp: mainwindow.h
	$(MOC) mainwindow.h -o moc_mainwindow.cpp

