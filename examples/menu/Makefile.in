#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
TARGET	= menu
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	menu.h
SOURCES =	menu.cpp
OBJECTS =	menu.o
SRCMOC	=	moc_menu.cpp
OBJMOC	=	moc_menu.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake menu.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

menu.o: menu.cpp \
		menu.h \
		../../include/qwidget.h \
		../../include/qwindowdefs.h \
		../../include/qobjectdefs.h \
		../../include/qglobal.h \
		../../include/qstring.h \
		../../include/qcstring.h \
		../../include/qarray.h \
		../../include/qgarray.h \
		../../include/qshared.h \
		../../include/qnamespace.h \
		../../include/qobject.h \
		../../include/qevent.h \
		../../include/qregion.h \
		../../include/qrect.h \
		../../include/qsize.h \
		../../include/qpoint.h \
		../../include/qmime.h \
		../../include/qlist.h \
		../../include/qglist.h \
		../../include/qcollection.h \
		../../include/qstringlist.h \
		../../include/qvaluelist.h \
		../../include/qdatastream.h \
		../../include/qiodevice.h \
		../../include/qpaintdevice.h \
		../../include/qpalette.h \
		../../include/qcolor.h \
		../../include/qbrush.h \
		../../include/qcursor.h \
		../../include/qfont.h \
