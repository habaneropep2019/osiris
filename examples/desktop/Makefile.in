#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
VER_PATCH = 0
TARGET	= desktop
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	
SOURCES =	desktop.cpp
OBJECTS =	desktop.o
SRCMOC	=	
OBJMOC	=	

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake desktop.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

desktop.o: desktop.cpp \
		../../include/qimage.h \
		../../include/qpixmap.h \
		../../include/qpaintdevice.h \
		../../include/qwindowdefs.h \
		../../include/qobjectdefs.h \
		../../include/qglobal.h \
		../../include/qstring.h \
		../../include/qcstring.h \
		../../include/qarray.h \
		../../include/qgarray.h \
		../../include/qshared.h \
		../../include/qnamespace.h \
		../../include/qrect.h \
		../../include/qsize.h \
		../../include/qpoint.h \
		../../include/qcolor.h \
		../../include/qstrlist.h \
		../../include/qlist.h \
		../../include/qglist.h \
		../../include/qcollection.h \
		../../include/qdatastream.h \
		../../include/qiodevice.h \
		../../include/qbitmap.h \
		../../include/qpainter.h \
		../../include/qfontmetrics.h \
		../../include/qfont.h \
		../../include/qfontinfo.h \
		../../include/qregion.h \
		../../include/qpen.h \
		../../include/qbrush.h \
		../../include/qpointarray.h \
		../../include/qwmatrix.h \
		../../include/qapplication.h \
		../../include/qwidget.h \
		../../include/qobject.h \
		../../include/qevent.h \
		../../include/qmime.h \
		../../include/qstringlist.h \
		../../include/qvaluelist.h \
		../../include/qpalette.h \
		../../include/qcursor.h \
		../../include/qstyle.h \
		../../include/qsizepolicy.h \
		../../include/qasciidict.h \
		../../include/qgdict.h \
		../../include/qtranslator.h \
		../../include/qintdict.h \
		../../include/qdropsite.h \
		../../include/qdragobject.h

