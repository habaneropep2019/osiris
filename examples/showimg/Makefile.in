#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
VER_PATCH = 0
TARGET	= showimg
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	showimg.h \
		imagetexteditor.h \
		imagefip.h
SOURCES =	main.cpp \
		imagetexteditor.cpp \
		showimg.cpp \
		imagefip.cpp
OBJECTS =	main.o \
		imagetexteditor.o \
		showimg.o \
		imagefip.o
SRCMOC	=	moc_showimg.cpp \
		moc_imagetexteditor.cpp \
		moc_imagefip.cpp
OBJMOC	=	moc_showimg.o \
		moc_imagetexteditor.o \
		moc_imagefip.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake showimg.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

main.o: main.cpp \
		showimg.h \
		imagefip.h

imagetexteditor.o: imagetexteditor.cpp \
		imagetexteditor.h

showimg.o: showimg.cpp \
		showimg.h \
		imagetexteditor.h

imagefip.o: imagefip.cpp \
		imagefip.h

moc_showimg.o: moc_showimg.cpp \
		showimg.h

moc_imagetexteditor.o: moc_imagetexteditor.cpp \
		imagetexteditor.h

moc_imagefip.o: moc_imagefip.cpp \
		imagefip.h

moc_showimg.cpp: showimg.h
	$(MOC) showimg.h -o moc_showimg.cpp

moc_imagetexteditor.cpp: imagetexteditor.h
	$(MOC) imagetexteditor.h -o moc_imagetexteditor.cpp

moc_imagefip.cpp: imagefip.h
	$(MOC) imagefip.h -o moc_imagefip.cpp

