#############################################################################

####### Compiler, tools and options

CXX	=	$(SYSCONF_CXX)
CXXFLAGS=	$(SYSCONF_CXXFLAGS_QT) $(SYSCONF_CXXFLAGS)
CC	=	$(SYSCONF_CC)
CFLAGS	=	$(SYSCONF_CFLAGS)
INCPATH =	
LFLAGS	=	$(SYSCONF_LFLAGS_QT) $(SYSCONF_LFLAGS_X11) $(SYSCONF_LFLAGS)
LIBS	=	$(SYSCONF_LIBS_QT) $(SYSCONF_LIBS_X11) $(SYSCONF_LIBS)
MOC	=	$(SYSCONF_MOC)

####### Target

DESTDIR = ./
VER_MAJ = 1
VER_MIN = 0
VER_PATCH = 0
TARGET	= qdir
TARGET1 = lib$(TARGET).so.$(VER_MAJ)

####### Files

HEADERS =	qdir.h \
		../dirview/dirview.h
SOURCES =	qdir.cpp \
		../dirview/dirview.cpp
OBJECTS =	qdir.o \
		../dirview/dirview.o
SRCMOC	=	moc_qdir.cpp \
		../dirview/moc_dirview.cpp
OBJMOC	=	moc_qdir.o \
		../dirview/moc_dirview.o

####### Implicit rules

.SUFFIXES: .cpp .cxx .cc .C .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.C.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

all: $(DESTDIR)$(TARGET)

$(DESTDIR)$(TARGET): $(OBJECTS) $(OBJMOC) 
	$(SYSCONF_LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(OBJMOC) $(LIBS)

moc: $(SRCMOC)

tmake:
	tmake qdir.pro

clean:
	-rm -f $(OBJECTS) $(OBJMOC) $(SRCMOC)
	-rm -f *~ core

####### Compile

qdir.o: qdir.cpp \
		../dirview/dirview.h \
		qdir.h

../dirview/dirview.o: ../dirview/dirview.cpp \
		../dirview/dirview.h \
		qdir.h

moc_qdir.o: moc_qdir.cpp \
		qdir.h

../dirview/moc_dirview.o: ../dirview/moc_dirview.cpp \
		../dirview/dirview.h

moc_qdir.cpp: qdir.h
	$(MOC) qdir.h -o moc_qdir.cpp

../dirview/moc_dirview.cpp: ../dirview/dirview.h
	$(MOC) ../dirview/dirview.h -o ../dirview/moc_dirview.cpp

