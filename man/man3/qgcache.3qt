.TP
virtual void \fBclear\fR () 
.TP
bool \fBinsert_string\fR ( const QString & key, QCollection::Item, int cost, int priority ) 
.TP
bool \fBinsert_other\fR ( const char * key, QCollection::Item, int cost, int priority ) 
.TP
bool \fBremove_string\fR ( const QString & key ) 
.TP
bool \fBremove_other\fR ( const char * key ) 
.TP
