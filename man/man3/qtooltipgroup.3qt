.SH NAME
QToolTipGroup \- Collects tool tips into natural groups
.SH SYNOPSIS
.br
.PP
\fC#include <qtooltip.h>\fR
.PP
Inherits QObject.
.PP
.SS "Public Members"
.in +1c
.ti -1c
